APP_NAME="HSEQ Capacitaciones"
APP_ENV=development
APP_DEBUG=true
APP_URL=http://localhost:8080
APP_KEY=change-this-to-a-random-32-char-string

DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=meridian_capacitaciones
DB_USERNAME=root
DB_PASSWORD=

# Base de personal (misma instancia MySQL). En cPanel el nombre lleva prefijo de cuenta.
# Si HOST/USER/PASSWORD se omiten, se reutilizan los de capacitaciones.
DB_PERSONAL_HOST=127.0.0.1
DB_PERSONAL_NAME=meridian_personal
DB_PERSONAL_USER=root
DB_PERSONAL_PASSWORD=
# Alias conservado por compatibilidad con entornos que ya usan este nombre:
DB_PERSONAL_DATABASE=meridian_personal

JWT_SECRET=change-this-to-a-random-64-char-string
JWT_EXPIRATION=3600

CORS_ALLOWED_ORIGINS=http://localhost:3000
CORS_ALLOWED_METHODS=GET,POST,PUT,PATCH,DELETE,OPTIONS
CORS_ALLOWED_HEADERS=Content-Type,Authorization,X-Requested-With

LOG_LEVEL=debug
UPLOAD_MAX_SIZE=10485760
