# Sitio estatico generado por "next build" (output: "export").
# Cada ruta ya existe como carpeta/index.html gracias a trailingSlash: true,
# asi que el DirectoryIndex por defecto de Apache la sirve sin reescrituras.

Options -Indexes

# Apuntar al archivo, no a la carpeta. ErrorDocument 404 /404/ entra en bucle
# interno (la subpeticion no resuelve index.html) y Apache responde 500.
ErrorDocument 404 /404/index.html

<IfModule mod_rewrite.c>
  RewriteEngine On

  # El export hecho en Windows guarda los segmentos RSC como carpetas
  # (dashboard/__next.!KGFwcCk/dashboard/__PAGE__.txt). El navegador pide
  # el nombre aplanado con puntos. Cada regla convierte un punto en barra.
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteRule ^((?:.*/)?__next(?:/[^/.]+)*)\.([^/.]+)(.*)\.txt$ $1/$2$3.txt [QSA]

  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteRule ^((?:.*/)?__next(?:/[^/.]+)*)\.([^/.]+)(.*)\.txt$ $1/$2$3.txt [QSA]

  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteRule ^((?:.*/)?__next(?:/[^/.]+)*)\.([^/.]+)(.*)\.txt$ $1/$2$3.txt [QSA]

  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteRule ^((?:.*/)?__next(?:/[^/.]+)*)\.([^/.]+)(.*)\.txt$ $1/$2$3.txt [QSA]

  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteRule ^((?:.*/)?__next(?:/[^/.]+)*)\.([^/.]+)(.*)\.txt$ $1/$2$3.txt [QSA]

  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteRule ^((?:.*/)?__next(?:/[^/.]+)*)\.([^/.]+)(.*)\.txt$ $1/$2$3.txt [QSA]
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/x-icon "access plus 1 year"
</IfModule>
